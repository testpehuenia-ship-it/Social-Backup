# Social Backup by ADNQN — Variables de Entorno

# Base de datos (SQLite para desarrollo local sin docker obligatorio, o PostgreSQL)
DATABASE_URL="file:./dev.db"

# JWT / Clave secreta para sesiones seguras
SESSION_SECRET="super-secret-key-change-in-production-socialbackup-adnqn-2026"

# URL pública de la aplicación
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Entorno: development | test | production
NODE_ENV="development"

# Adaptador de Correo: mock | resend | smtp
EMAIL_PROVIDER="mock"
EMAIL_FROM_ADDRESS="no-reply@socialbackup.adnqn.com"
RESEND_API_KEY=""

# Cuotas Plan Free
FREE_PLAN_MAX_CONTACTS=100
FREE_PLAN_MAX_FORMS=1
